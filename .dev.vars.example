# Local development only. Copy to .dev.vars and fill in your OWN values.
# Never commit .dev.vars. Set production values using Wrangler secrets.
APP_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
CF_REALTIME_APP_ID=REPLACE_WITH_YOUR_SFU_APP_ID
CF_REALTIME_APP_SECRET=REPLACE_WITH_YOUR_SFU_APP_SECRET
TURN_KEY_ID=REPLACE_WITH_YOUR_TURN_KEY_ID
TURN_KEY_API_TOKEN=REPLACE_WITH_YOUR_TURN_API_TOKEN
