{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiahao-private-cinema",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "CinemaRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "CinemaDirectory"
      },
      {
        "name": "AUTH_LIMITER",
        "class_name": "AuthRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CinemaRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CinemaDirectory", "AuthRateLimiter"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
