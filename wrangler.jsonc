{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiahao-private-cinema",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "CinemaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CinemaRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
